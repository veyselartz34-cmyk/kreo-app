generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  avatar    String?
  bio       String?
  cover     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  meetings  Meeting[]
}

model Product {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float
  type        String   // "Dijital Ürün" veya "Abonelik"
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Meeting {
  id        String   @id @default(cuid())
  title     String
  clientName String
  clientEmail String
  date      String
  time      String
  link      String?
  status    String   // "Başarılı", "Onaylandı", "İptal"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
